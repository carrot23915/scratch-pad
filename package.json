{
  "name": "scratch-pad-portable",
  "productName": "Scratch Pad Portable",
  "version": "1.0.6",
  "description": "Scratch Pad Portable \u2014 multi-tab notes with Import/Export",
  "main": "main.js",
  "author": "Scratch Pad Portable",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable --x64",
    "build:dir": "electron-builder --win dir --x64",
    "build:zip": "electron-builder --win zip --x64",
    "build:msix": "electron-builder --win appx --x64"
  },
  "build": {
    "appId": "com.scratchpadportable.app",
    "productName": "Scratch Pad Portable",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "styles.css",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "appx",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Scratch Pad Portable ${version}.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "appx": {
      "identityName": "ScratchPadPortable.ScratchPadPortable",
      "applicationId": "ScratchPadPortable",
      "publisher": "CN=ScratchPadPortable",
      "publisherDisplayName": "Scratch Pad Portable",
      "displayName": "Scratch Pad Portable",
      "languages": [
        "en-US"
      ],
      "showNameOnTiles": true,
      "setBuildNumber": true
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
